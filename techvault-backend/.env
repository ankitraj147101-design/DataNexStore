# DataNexStore Backend - Development Environment
# Copy this file and update with your actual credentials

# Server
PORT=8080

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/datanexstore
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Base64 256-bit)
JWT_SECRET=ZGF0YW5leHN0b3JlLXN1cGVyLXNlY3JldC1qd3Qta2V5LWF0LWxlYXN0LTI1Ni1iaXRzLWxvbmctZm9yLWhzMjU2LTIwMjY=
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# Cloudinary (Update with your credentials)
CLOUDINARY_CLOUD_NAME=datanex-cloud
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay Payment Gateway (Update with your credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Twilio WhatsApp Integration (UPDATE THESE!)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@datanexstore.in
MAIL_PASSWORD=
MAIL_FROM=noreply@datanexstore.in

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
